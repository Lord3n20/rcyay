#!/bin/bash
# Ende-zu-Ende-Test rcyay-dienste (rcyay-e1b, 26.11.2026): echte Inits (BusyBox init,
# runit, s6) als PID 1 in einem PID-/Mount-/Netz-Namensraum über einem Arch-chroot.
# NUR in einer Wegwerf-VM als root (bau-e1).
#   e2e-chroot BAUORDNER BOOTSKRIPTE
#     BAUORDNER   = meson-Bauordner von rcyay (z. B. ~bau/b), wird per meson install ins chroot gelegt
#     BOOTSKRIPTE = Ordner mit rc.start, rc.stop, runit-1/2/3, s6-rc.init (usrside-dienste von rcyay-e2)
# Umgebung: CH (chroot, Standard /root/dienste-ch), S6PKG (Ordner mit skalibs/execline/s6-Paketen,
#           sonst baut rcyay sie aus dem AUR).
# Prüft je Init: sshd, dhcpcd, seatd laufen und werden vom Init überwacht (nach kill neu gestartet),
# sshd antwortet, Einmal-Dienst sshdgenkeys lief (start.d), Hook übersetzt beim Installieren.
set -u
BAU=$(readlink -f "${1:?meson-Bauordner}")
BOOT=$(readlink -f "${2:?Ordner mit den Startskripten}")
HIER=$(cd "$(dirname "$0")" && pwd)
CH=${CH:-/root/dienste-ch}
[ "$(id -u)" = 0 ] || { echo "als root starten (Wegwerf-VM)"; exit 2; }
export LANG=C LC_ALL=C
N=0 FAIL=0
LOG=$(mktemp -d /tmp/rcyay-dienste-e2e.XXXXXX)
ok()   { N=$((N+1)); echo "ok $N - $1"; }
nok()  { N=$((N+1)); FAIL=$((FAIL+1)); echo "not ok $N - $1"; [ -n "${2:-}" ] && [ -f "$2" ] && sed 's/^/#   /' "$2" | tail -25; }
check() { local d=$1; shift; if "$@"; then ok "$d"; else nok "$d" "$LOG/init.log"; fi; }
bail() { echo "Bail out! $*"; exit 2; }

# ---------- chroot aufbauen (einmal) ----------
if [ ! -x "$CH/usr/bin/sshd" ]; then
  mkdir -p "$CH/var/lib/pacman" "$CH/var/cache/pacman/pkg"
  pacman -r "$CH" -Sy --noconfirm --needed base busybox openssh dhcpcd seatd iproute2 >"$LOG/pacstrap.log" 2>&1 || bail "pacman -r (Log $LOG/pacstrap.log)"
fi
# s6 aus dem AUR (Arch hat es nicht im Repo) – mit rcyay selbst gebaut
if [ ! -x "$CH/usr/bin/s6-svscan" ]; then
  if [ -z "${S6PKG:-}" ]; then
    S6PKG=/var/cache/rcyay-s6
    mkdir -p "$S6PKG"
    "$BAU/rcyay" -S --noconfirm --needed s6 >"$LOG/s6.log" 2>&1 || bail "rcyay -S s6 (Log $LOG/s6.log)"
    find /var/cache/rcyay -name '*.pkg.tar.zst' \( -name 'skalibs-*' -o -name 'execline-*' -o -name 's6-[0-9]*' \) -exec cp {} "$S6PKG/" \;
  fi
  pacman -r "$CH" -U --noconfirm "$S6PKG"/*.pkg.tar.zst >>"$LOG/s6.log" 2>&1 || bail "s6 ins chroot (Log $LOG/s6.log)"
fi
# runit: Arch hat es weder im Repo noch im AUR – die runit-Applets von BusyBox (runsvdir, runsv,
# sv, chpst) sind dieselben Programme; Stufe 1/2 wie runit(8), ohne das runit-Binär selbst
for b in runsvdir runsv sv chpst svlogd; do [ -e "$CH/usr/bin/$b" ] || ln -s busybox "$CH/usr/bin/$b"; done
mkdir -p "$CH/usr/lib/usrside"
cat > "$CH/usr/lib/usrside/runit-stufen" <<'S'
#!/bin/sh
# wie runit(8) als PID 1: Stufe 1, dann Stufe 2 (runsvdir)
/etc/runit/1
exec /etc/runit/2
S
chmod 755 "$CH/usr/lib/usrside/runit-stufen"
# rcyay ins chroot (meson install), Hooks von usrside-init, Startskripte von usrside-dienste
meson install -C "$BAU" --destdir "$CH" --no-rebuild >"$LOG/install.log" 2>&1 || bail "meson install (Log $LOG/install.log)"
chown -R --reference="$BAU" "$BAU/meson-logs" "$BAU/meson-private" 2>/dev/null  # root-Lauf im Bauordner des Nutzers
install -Dm644 "$HIER/../../../pkg/usrside-init/rcyay-dienste.hook" "$CH/usr/share/libalpm/hooks/rcyay-dienste.hook"
install -Dm644 "$HIER/../../../pkg/usrside-init/rcyay-dienste-weg.hook" "$CH/usr/share/libalpm/hooks/rcyay-dienste-weg.hook"
install -Dm755 "$BOOT/rc.start" "$CH/usr/lib/usrside/rc.start"
install -Dm755 "$BOOT/rc.stop" "$CH/usr/lib/usrside/rc.stop"
mkdir -p "$CH/etc/usrside/start.d" "$CH/etc/runit/runsvdir/default" "$CH/etc/s6-linux-init/current/run-image/service"
for s in 1 2 3; do install -Dm755 "$BOOT/runit-$s" "$CH/etc/runit/$s"; done
ln -sfn default "$CH/etc/runit/runsvdir/current"
ln -sfn /etc/runit/runsvdir/current "$CH/var/service" 2>/dev/null || { rm -rf "$CH/var/service"; ln -s /etc/runit/runsvdir/current "$CH/var/service"; }
printf '::sysinit:/usr/lib/usrside/rc.start\n::shutdown:/usr/lib/usrside/rc.stop\n' > "$CH/etc/inittab"
# s6 ohne s6-linux-init: dasselbe wie dessen Stufe 1 – run-image nach /run/service, rc.init, s6-svscan
cat > "$CH/usr/lib/usrside/s6-init" <<'S'
#!/bin/sh
/usr/lib/usrside/rc.start
cp -a /etc/s6-linux-init/current/run-image/service /run/service
( sleep 1; for s in /run/service/*/; do s6-svc -u "$s"; done ) &
exec s6-svscan /run/service
S
chmod 755 "$CH/usr/lib/usrside/s6-init"
# Einmal-Dienst zum Nachweis von start.d (rc.start erzeugt die SSH-Schlüssel ohnehin selbst)
printf '[Unit]\nDescription=rcyay Probe\nConditionPathExists=!/var/tmp/rcyay-aus\n[Service]\nType=oneshot\nExecStart=/usr/bin/touch /var/tmp/rcyay-oneshot\n[Install]\nWantedBy=multi-user.target\n' \
  > "$CH/usr/lib/systemd/system/rcyay-probe.service"
rm -f "$CH"/etc/ssh/ssh_host_*
ln -sf /usr/bin/busybox "$CH/usr/bin/mdev" 2>/dev/null; ln -sf /usr/bin/busybox "$CH/usr/bin/chpst.bb" 2>/dev/null

C() { chroot "$CH" "$@"; }
NSPID=
start_init() {   # $1 = Programm im chroot
  : > "$LOG/init.log"
  # eigenes /dev (tmpfs) und /proc mit schreibgeschütztem /proc/sys: rc.start ruft mdev -s auf und
  # setzt /proc/sys/kernel/hotplug – auf devtmpfs bzw. im echten /proc träfe das die VM selbst
  unshare --pid --fork --mount --net --uts --ipc --propagation private sh -c '
    CH=$1; shift
    mount -t tmpfs -o mode=0755 tmpfs "$CH/dev" || exit 1
    for n in "null 1 3" "zero 1 5" "full 1 7" "random 1 8" "urandom 1 9" "tty 5 0" "console 5 1"; do
      ( set -- $n; mknod -m 666 "$CH/dev/$1" c "$2" "$3" )
    done
    mount -t proc proc "$CH/proc" && mount --bind -o ro "$CH/proc/sys" "$CH/proc/sys" &&
      mount -o remount,bind,ro "$CH/proc/sys" || exit 1
    exec chroot "$CH" "$@"' sh "$CH" "$@" >"$LOG/init.log" 2>&1 &
  local u=$! i
  disown "$u" 2>/dev/null
  for i in $(seq 50); do NSPID=$(pgrep -P "$u" | head -1); [ -n "$NSPID" ] && break; sleep 0.1; done
}
stop_init() { [ -n "$NSPID" ] && kill -9 "$NSPID" 2>/dev/null; sleep 1; NSPID=; }
inns() { [ -n "$NSPID" ] && pgrep -a --ns "$NSPID" --nslist pid "$@"; }
# PID eines Prozesses im Namensraum (Host-Sicht), dessen Elternteil Init/Supervisor ist
pid_of() { pgrep --ns "$NSPID" --nslist pid -x "$1" | head -1; }
parent_comm() { local pp; pp=$(ps -o ppid= -p "$1" | tr -d ' '); ps -o comm= -p "$pp"; }
wait_for() { local i; for i in $(seq 60); do [ -n "$(pid_of "$1")" ] && return 0; sleep 0.5; done; return 1; }
sshd_answers() { nsenter -t "$NSPID" -n timeout 5 bash -c 'exec 3<>/dev/tcp/127.0.0.1/22; head -c 7 <&3' 2>/dev/null | grep -q SSH-2.0; }

pruefe() {   # $1 = Init, $2 = erwarteter Supervisor-Name (Elternprozess)
  local init=$1 sup=$2 d p alt neu
  for d in sshd dhcpcd seatd; do
    check "$init: $d läuft" wait_for "$d"
    p=$(pid_of "$d")
    [ -n "$p" ] && check "$init: $d wird von $sup überwacht" bash -c "[ \"\$(ps -o comm= -p \$(ps -o ppid= -p $p | tr -d ' '))\" = '$sup' ]"
  done
  check "$init: Einmal-Dienst rcyay-probe lief beim Start (start.d)" test -e "$CH/var/tmp/rcyay-oneshot"
  check "$init: sshd antwortet auf Port 22" sshd_answers
  alt=$(pid_of seatd)
  [ -n "$alt" ] && kill "$alt"
  sleep 3
  neu=$(pid_of seatd)
  check "$init: seatd nach kill neu gestartet" bash -c "[ -n '$neu' ] && [ '$neu' != '$alt' ]"
}

# ---------- je Init ----------
for INIT in runit s6 busybox; do
  C rcyay --init "$INIT" >"$LOG/rcyay-init-$INIT.log" 2>&1
  check "$INIT: rcyay --init $INIT" grep -qx "Init = $INIT" "$CH/etc/rcyay.conf"
  C rcyay --enable sshdgenkeys sshd dhcpcd seatd rcyay-probe >"$LOG/enable-$INIT.log" 2>&1
  check "$INIT: rcyay --enable (Exit 0)" [ $? = 0 ]
  rm -f "$CH"/etc/ssh/ssh_host_* "$CH/var/tmp/rcyay-oneshot"
  case $INIT in
    runit)   start_init /usr/lib/usrside/runit-stufen; SUP=runsv ;;
    s6)      start_init /usr/lib/usrside/s6-init; SUP=s6-supervise ;;
    busybox) start_init /usr/bin/busybox init; SUP=busybox ;;
  esac
  [ -n "$NSPID" ] || { nok "$INIT: Init startet nicht" "$LOG/init.log"; continue; }
    pruefe "$INIT" "$SUP"
  case $INIT in runit) P1=runsvdir ;; s6) P1=s6-svscan ;; busybox) P1=busybox ;; esac
  check "$INIT: PID 1 im Namensraum ist $P1" bash -c "[ \"\$(ps -o comm= -p $NSPID)\" = $P1 ] && grep -q '^NSpid:.*[[:space:]]1\$' /proc/$NSPID/status"
  inns >"$LOG/ps-$INIT.txt" 2>&1
  stop_init
done

# ---------- Hook: Paket mit Unit installieren/entfernen (Init = runit) ----------
C rcyay --init runit >/dev/null 2>&1
pacman -r "$CH" -S --noconfirm --needed networkmanager >"$LOG/hook.log" 2>&1
check "Hook: NetworkManager beim Installieren übersetzt" test -x "$CH/etc/rcyay/dienste/NetworkManager/run"
check "Hook-Ausgabe nennt D-Bus" grep -q "D-Bus" "$LOG/hook.log"
C rcyay --enable NetworkManager >/dev/null 2>&1
check "runit: NetworkManager eingeschaltet" test -L "$CH/etc/runit/runsvdir/default/NetworkManager"
pacman -r "$CH" -R --noconfirm networkmanager >>"$LOG/hook.log" 2>&1
check "Hook: beim Entfernen ausgeschaltet und gelöscht" bash -c "[ ! -e '$CH/etc/rcyay/dienste/NetworkManager' ] && [ ! -e '$CH/etc/runit/runsvdir/default/NetworkManager' ]"

echo "1..$N"
[ $FAIL = 0 ] && { echo "# alle $N Tests grün (Logs $LOG)"; exit 0; }
echo "# $FAIL von $N Tests fehlgeschlagen (Logs $LOG)"; exit 1
