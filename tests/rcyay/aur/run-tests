#!/bin/bash
# Ende-zu-Ende-Tests für rcyay gegen das Mock-AUR (rcyay-e1, 26.11.2026).
# NUR in einer Wegwerf-VM als root ausführen – installiert/entfernt Pakete rc-*.
#   run-tests RCYAY [NUTZER]
#     RCYAY  = Pfad zum gebauten rcyay (z. B. ~bau/b/rcyay)
#     NUTZER = normaler Nutzer mit sudo ohne Passwort für den Nutzer-Durchlauf (Standard bau)
# Ausgabe im TAP-Format, Exit-Code 0 = alles grün.
set -u
RCYAY=$(readlink -f "${1:?Pfad zu rcyay}")
NUTZER=${2:-bau}
HIER=$(cd "$(dirname "$0")" && pwd)
PORT=${RCYAY_MOCK_PORT:-8099}
[ "$(id -u)" = 0 ] || { echo "als root starten (Wegwerf-VM)"; exit 2; }
export LANG=C LC_ALL=C

W=$(mktemp -d /tmp/rcyay-e2e.XXXXXX)
chmod 755 "$W"
N=0 FAIL=0
ok()   { N=$((N+1)); echo "ok $N - $1"; }
nok()  { N=$((N+1)); FAIL=$((FAIL+1)); echo "not ok $N - $1"; [ -f "$W/out" ] && sed 's/^/#   /' "$W/out" | tail -25; }
check() { local d=$1; shift; if "$@"; then ok "$d"; else nok "$d"; fi; }
installed() { pacman -Q "$1" >/dev/null 2>&1; }
notinst()  { ! pacman -Q "$1" >/dev/null 2>&1; }
reason()   { pacman -Qi "$1" 2>/dev/null | grep -q "^Install Reason *: $2"; }
ver()      { [ "$(pacman -Q "$1" 2>/dev/null | cut -d' ' -f2)" = "$2" ]; }
has()      { grep -q -- "$1" "$W/out"; }
hasnot()   { ! grep -q -- "$1" "$W/out"; }
aufraeumen() { rm -f /var/cache/pacman/pkg/rc-*; local p; p=$(pacman -Qq 2>/dev/null | grep '^rc-'); [ -n "$p" ] && pacman -Rdd --noconfirm $p >/dev/null 2>&1; true; }
vp_weg() { pacman -Q usrside-provides >/dev/null 2>&1 && pacman -Rdd --noconfirm usrside-provides >/dev/null 2>&1; rm -f /var/cache/pacman/pkg/usrside-provides-*; true; }

# ---------- Aufbau ----------
cp -r "$HIER/pkgs" "$W/aur"; cp -r "$HIER/repo" "$W/repo-src"; cp -r "$HIER/pkgs-v2" "$W/aur-v2"
mkdir -p "$W/repo"
chown -R nobody: "$W/aur" "$W/aur-v2" "$W/repo-src" "$W/repo"
srcinfo() { runuser -u nobody -- bash -c "cd '$1' && makepkg --printsrcinfo > .SRCINFO"; }
# rc-pgp: signierte Quelle, Schlüssel nur auf dem Mock-Schlüsselserver (validpgpkeys)
mkdir -p "$W/overlay"; printf '# Testliste\nrc-gelist*  braucht glibc-Symbole\n' > "$W/overlay/nur-glibc.txt"
mkdir -p "$W/keys" "$W/aur/rc-pgp"
export GNUPGHOME="$W/gpg-signer"; mkdir -m 700 "$GNUPGHOME"
gpg --batch --quiet --passphrase '' --quick-gen-key 'rcyay Test <rcyay@test.invalid>' ed25519 sign never 2>/dev/null || { echo "Bail out! gpg-Schlüssel"; exit 2; }
FPR=$(gpg --with-colons --list-keys 2>/dev/null | awk -F: '/^fpr:/ {print $10; exit}')
gpg --armor --export "$FPR" > "$W/keys/$FPR.asc" 2>/dev/null
echo "rcyay signiert" > "$W/aur/rc-pgp/daten.txt"
gpg --batch --quiet --detach-sign "$W/aur/rc-pgp/daten.txt" 2>/dev/null
unset GNUPGHOME
chown -R nobody: "$W/aur/rc-pgp"
cat > "$W/aur/rc-pgp/PKGBUILD" <<P
pkgname=rc-pgp
pkgver=1.0
pkgrel=1
arch=(any)
license=(MIT)
pkgdesc="rcyay Testpaket mit PGP-Signatur"
source=(daten.txt daten.txt.sig)
sha256sums=(SKIP SKIP)
validpgpkeys=($FPR)
package() { install -Dm644 "\$srcdir/daten.txt" "\$pkgdir/usr/share/rcyay-test/rc-pgp"; }
P
chown nobody: "$W/aur/rc-pgp/PKGBUILD"
for d in "$W"/aur/* "$W"/aur-v2/* "$W"/repo-src/*; do srcinfo "$d" || { echo "Bail out! SRCINFO $d"; exit 2; }; done
for d in "$W"/repo-src/*; do
  runuser -u nobody -- bash -c "cd '$d' && PKGDEST='$W/repo' makepkg -f -d >/dev/null 2>&1" || { echo "Bail out! Repo-Paket $d"; exit 2; }
done
repo-add -q "$W/repo/rcyaytest.db.tar.gz" "$W"/repo/*.pkg.tar.* >/dev/null || { echo "Bail out! repo-add"; exit 2; }
{ cat /etc/pacman.conf; printf '\n[rcyaytest]\nSigLevel = Never\nServer = file://%s/repo\n' "$W"; } > "$W/pacman.conf"
pacman --config "$W/pacman.conf" -Sy >/dev/null 2>&1 || { echo "Bail out! pacman -Sy"; exit 2; }
cat > "$W/rcyay.conf" <<C
[options]
AURURL = http://127.0.0.1:$PORT
RepoGitURL = http://127.0.0.1:$PORT/gitlab
BuildDir = $W/bau-root
PGPKeyserver = hkp://127.0.0.1:$PORT
Overlay = $W/overlay
C
grep -v BuildDir "$W/rcyay.conf" > "$W/rcyay-nutzer.conf"
chmod 644 "$W"/*.conf
python3 "$HIER/server.py" --port "$PORT" --pkgs "$W/aur" --repo-dir "$W/repo-src" --log "$W/server.log" --keys "$W/keys" >"$W/server.out" 2>&1 &
SRV=$!
trap 'kill $SRV 2>/dev/null; aufraeumen; vp_weg' EXIT
for _ in $(seq 50); do grep -q bereit "$W/server.out" 2>/dev/null && break; sleep 0.1; done
aufraeumen
rm -f /tmp/rcyay-devver

R()  { "$RCYAY" --config "$W/pacman.conf" --rcyayconf "$W/rcyay.conf" "$@" >"$W/out" 2>&1; }
RU() { runuser -u "$NUTZER" -- env HOME="$(getent passwd "$NUTZER" | cut -d: -f6)" \
         "$RCYAY" --config "$W/pacman.conf" --rcyayconf "$W/rcyay-nutzer.conf" "$@" >"$W/out" 2>&1; }

# ---------- Grundlagen ----------
R -V;                 check "-V zeigt rcyay-Version" has "^rcyay v"
R -Q pacman;          check "-Q wird an pacman durchgereicht" has "^pacman "
R -Ss rc-hello;       check "-Ss findet AUR-Paket" has "^aur/rc-hello 1.0-1"
R -Ss repodep;        check "-Ss findet Repo-Paket" has "^rcyaytest/rc-repodep"
R -Ss --aur Kette;    check "-Ss --aur nur AUR (4 Treffer)" [ "$(grep -c '^aur/' "$W/out")" = 4 ]
R -Ss --aur --topdown Kette; check "Sortierung nach Stimmen, --topdown: beste zuerst" bash -c "grep '^aur/' '$W/out' | head -1 | grep -q rc-chain-c-old"
R -Ss --aur Kette;   check "Standard BottomUp: beste zuletzt" bash -c "grep '^aur/' '$W/out' | tail -1 | grep -q rc-chain-c-old"
R -Ss --aur --sortby name --topdown Kette; check "--sortby name" bash -c "grep '^aur/' '$W/out' | head -1 | grep -q rc-chain-a"
R -Ss --sortby quatsch Kette; r=$?; check "--sortby ungültig -> Fehler" [ $r != 0 ]
R -Ssq rc-chain;      check "-Ssq nur Namen" has "^rc-chain-b$"
R -Ss gibtsnichtxyz;  r=$?; check "-Ss ohne Treffer: Exit 1" [ $r = 1 ]
R -Si rc-hello;       check "-Si AUR-Info" has "^Repository *: aur"
R -Si rc-repodep;     check "-Si Repo-Info" has "^Repository *: rcyaytest"
R -Si gibtsnichtxyz;  r=$?; check "-Si unbekannt: Fehler" [ $r != 0 ]
R -Ps;                check "-Ps Statistik" has "Installed packages"

# ---------- Installation als root (Bau-Nutzer) ----------
R -S --noconfirm rc-hello; r=$?
check "-S rc-hello (root)" [ $r = 0 ]
check "rc-hello installiert, ausdrücklich" reason rc-hello Explicitly
check "makepkg lief als rcyay-bau, nicht root" grep -q " rcyay-bau$" /usr/share/rcyay-test/rc-hello
R -S --noconfirm --needed rc-hello; check "--needed: aktuell -> übersprungen" has "is up to date"

R -S --noconfirm rc-chain-a; r=$?
check "-S Kette AUR→AUR→provides + Repo-Abh. (Exit 0)" [ $r = 0 ]
check "rc-chain-a ausdrücklich" reason rc-chain-a Explicitly
check "rc-chain-b als Abhängigkeit" reason rc-chain-b "Installed as a dependency"
check "rc-chain-c über provides: rc-chain-c-neu" installed rc-chain-c-neu
check "zu alter Anbieter rc-chain-c-old nicht gewählt" notinst rc-chain-c-old
check "Repo-Abhängigkeit rc-repodep installiert" reason rc-repodep "Installed as a dependency"
check "Bauabh. rc-maketool entfernt" notinst rc-maketool
check "Bauabh. rc-maketool-lib entfernt" notinst rc-maketool-lib
check "Repo-Bauabh. rc-repomake entfernt" notinst rc-repomake
check "Bauordnung: c vor b vor a" bash -c "grep -n 'Building' '$W/out' | grep -o 'rc-chain-[a-c][a-z-]*' | tr '\n' ' ' | grep -q 'rc-chain-c-neu rc-chain-b rc-chain-a'"

R -S --noconfirm rc-needsplit; r=$?
check "-S rc-needsplit (split-Paket als Abh.)" [ $r = 0 ]
check "rc-split-b installiert" installed rc-split-b
check "rc-split-a installiert (Abh. von split-b)" installed rc-split-a
check "rc-split nur einmal gebaut" [ "$(grep -c 'Building rc-split ' "$W/out")" = 1 ]

R -S --noconfirm rc-cyc1; r=$?
check "Zyklus wird erkannt (Exit != 0)" [ $r != 0 ]
check "Zyklus-Meldung" has "cycle"
check "nichts aus dem Zyklus installiert" notinst rc-cyc1

R -S --noconfirm rc-missing; r=$?
check "fehlende Abhängigkeit -> Fehler" [ $r != 0 ]
check "Meldung nennt fehlende Abhängigkeit" has "gibt-es-nicht-rcyay"

R -S --noconfirm rc-gibtsnicht; r=$?
check "unbekanntes Ziel -> Fehler" [ $r != 0 ]

R -S --noconfirm rc-badsum; r=$?
check "Prüfsummenfehler -> Bau scheitert" [ $r != 0 ]
check "rc-badsum nicht installiert" notinst rc-badsum

R -S --noconfirm --noremovemake rc-chain-a; r=$?
check "--noremovemake: Bau ok" [ $r = 0 ]
check "--noremovemake: rc-maketool bleibt (als Abh.)" reason rc-maketool "Installed as a dependency"

R -Yc --noconfirm; r=$?
check "-Yc entfernt verwaiste Abhängigkeiten" bash -c "[ $r = 0 ] && ! pacman -Q rc-maketool >/dev/null 2>&1"
check "-Yc lässt Benötigtes stehen" installed rc-chain-b

# ---------- Aktualisierung, Diff, --devel ----------
R -S --noconfirm rc-up; check "rc-up 1.0 installiert" ver rc-up 1.0-1
R -Sua --noconfirm; check "-Sua ohne Neuerungen" has "there is nothing to do in the AUR"
cp "$W/aur-v2/rc-up/PKGBUILD" "$W/aur-v2/rc-up/.SRCINFO" "$W/aur/rc-up/"
yes y | R -Sua; r=$?
check "-Sua aktualisiert rc-up (mit Rückfragen)" bash -c "[ $r = 0 ]"
check "rc-up jetzt 2.0" ver rc-up 2.0-1
check "Diff zeigt Versionsänderung" has "^+pkgver=2.0"
check "Diff zeigt alte Version" has "^-pkgver=1.0"

echo 1 > /tmp/rcyay-devver; chmod 644 /tmp/rcyay-devver
R -S --noconfirm rc-dev-git; check "rc-dev-git 1 installiert" ver rc-dev-git 1-1
R -Sua --devel --noconfirm; r=$?
check "--devel: unverändert -> übersprungen" bash -c "[ $r = 0 ] && grep -q 'is up to date' '$W/out'"
echo 2 > /tmp/rcyay-devver
R -Sua --devel --noconfirm; check "--devel: neue pkgver -> aktualisiert" ver rc-dev-git 2-1

# vorab eingegebene Antworten: makepkg darf sie nicht verschlucken (stdin = /dev/null)
aufraeumen_one() { pacman -Rdd --noconfirm "$1" >/dev/null 2>&1; true; }
aufraeumen_one rc-hello
yes y | head -n 50 | R -S rc-hello; r=$?
check "gepipte Antworten reichen bis zur Installation" bash -c "[ $r = 0 ] && pacman -Q rc-hello >/dev/null"

# Snapshot als HTTP 200 ohne Körper: einmal neu laden, beim zweiten Mal klarer Fehler
aufraeumen_one rc-hello
echo 1 > "$W/aur/rc-hello.leer"
R -S --noconfirm rc-hello; r=$?
check "leerer Snapshot: neu geladen und installiert" bash -c "[ $r = 0 ] && pacman -Q rc-hello >/dev/null"
check "leerer Snapshot: Warnung" has "archive is empty.*downloading again"
aufraeumen_one rc-hello
echo 2 > "$W/aur/rc-hello.leer"
R -S --noconfirm rc-hello; r=$?
check "zweimal leer: Abbruch mit HTTP-Status und Größe" bash -c "[ $r != 0 ] && grep -q 'HTTP 200, 0 bytes' '$W/out'"
rm -f "$W/aur/rc-hello.leer"

# ---------- Prüfung vor dem Bau ----------
printf 'y\nn\n' | R -S rc-install; r=$?
check "Ablehnen nach PKGBUILD-Anzeige bricht ab" bash -c "[ $r != 0 ] && ! pacman -Q rc-install >/dev/null 2>&1"
check "PKGBUILD wurde angezeigt" has "^pkgname=rc-install"
check ".install-Datei wurde angezeigt" has "post_install"

# ---------- -G / -Gp ----------
mkdir -p "$W/g"; ( cd "$W/g" && "$RCYAY" --config "$W/pacman.conf" --rcyayconf "$W/rcyay.conf" -G rc-split rc-repodep >"$W/out" 2>&1 ); r=$?
check "-G holt AUR-Bauordner" test -f "$W/g/rc-split/PKGBUILD" -a -f "$W/g/rc-split/.SRCINFO"
check "-G holt Repo-Bauordner (gitlab)" test -f "$W/g/rc-repodep/PKGBUILD"
R -Gp rc-hello; check "-Gp zeigt PKGBUILD" has "^pkgname=rc-hello"
R -G --repo rc-hello; r=$?; check "-G --repo für AUR-Paket -> Fehler" [ $r != 0 ]

# ---------- interaktive Suche ----------
{ echo 1; yes y; } | R rc-hello; r=$?
check "rcyay WORT: Auswahl 1 installiert" bash -c "[ $r = 0 ] && grep -q 'aur/rc-hello' '$W/out'"

# ---------- musl-Architektur x86_64_musl ----------
sed -e '/^Architecture/d' -e 's/^\[options\]$/[options]\nArchitecture = x86_64_musl/' "$W/pacman.conf" > "$W/pacman-musl.conf"
printf 'n\n' | "$RCYAY" --config "$W/pacman-musl.conf" --rcyayconf "$W/rcyay.conf" -S rc-musl >"$W/out" 2>&1
check "musl: Plan ohne depends_x86_64 (bis zur Bau-Frage)" bash -c "grep -q 'Proceed with building' '$W/out' && ! grep -q rc-gibt-es-nicht-glibc '$W/out'"
M() { "$RCYAY" --config "$W/pacman-musl.conf" --rcyayconf "$W/rcyay.conf" "$@" >"$W/out" 2>&1; }
M -S --noconfirm rc-x86only; r=$?
check "musl: arch=(x86_64) wird als Quell-Bau zugelassen (ungetestet)" bash -c "grep -q 'untested on musl' '$W/out' && ! grep -q 'only for glibc' '$W/out'"
check "musl: ohne _x86_64_musl gelten die _x86_64-Felder" bash -c "[ $r != 0 ] && grep -q rc-gibt-es-nicht-x86 '$W/out'"
M -S --noconfirm rc-foo-bin; r=$?
check "musl: -bin -> nur glibc" bash -c "[ $r != 0 ] && grep -q 'rc-foo-bin: only for glibc - prebuilt binary' '$W/out'"
M -S --noconfirm rc-debsrc; r=$?
check "musl: .deb als Quelle -> nur glibc" bash -c "[ $r != 0 ] && grep -q 'rc-debsrc: only for glibc - source rc-debsrc_1.0_amd64.deb' '$W/out'"
M -S --noconfirm rc-gelistet; r=$?
check "musl: nur-glibc.txt (Muster) -> nur glibc mit Grund" bash -c "[ $r != 0 ] && grep -q 'listed in nur-glibc.txt (braucht glibc-Symbole)' '$W/out'"
printf 'n\n' | M -S --force-musl rc-foo-bin
check "--force-musl übersteuert -bin" bash -c "grep -q 'Proceed with building' '$W/out' && ! grep -q 'only for glibc' '$W/out'"
M -S --noconfirm --force-musl rc-gelistet; r=$?
check "--force-musl übersteuert nur-glibc.txt nicht" bash -c "[ $r != 0 ] && grep -q 'nur-glibc.txt' '$W/out'"
R -S --noconfirm rc-foo-bin; r=$?
check "glibc: -bin normal gebaut" [ $r = 0 ]
R -S --noconfirm rc-musl; r=$?
check "glibc: depends_x86_64 gilt (fehlende Abh. gemeldet)" bash -c "[ $r != 0 ] && grep -q rc-gibt-es-nicht-glibc '$W/out'"

# ---------- PGP-Schlüssel (validpgpkeys) ----------
BAUHOME=$(getent passwd rcyay-bau | cut -d: -f6)
gpgbau() { runuser -u rcyay-bau -- env HOME="$BAUHOME" gpg --batch "$@"; }
schluessel_weg() { gpgbau --yes --delete-keys "$FPR" >/dev/null 2>&1; true; }
schluessel_weg
R -S --noconfirm --nopgpfetch rc-pgp; r=$?
check "--nopgpfetch: fehlender Schlüssel -> Bau scheitert" [ $r != 0 ]
check "fehlender Schlüssel wird mit Paket angezeigt" has "$FPR, required by: rc-pgp"
check "--nopgpfetch: kein Import" bash -c "! grep -q 'pks/lookup' '$W/server.log'"
printf 'y\ny\nn\n' | R -S rc-pgp; r=$?
check "Import abgelehnt -> Bau scheitert" bash -c "[ $r != 0 ] && grep -q 'Import?' '$W/out'"
R -S --noconfirm rc-pgp; r=$?
check "--noconfirm: Schlüssel automatisch importiert, Bau ok" [ $r = 0 ]
check "rc-pgp installiert" installed rc-pgp
check "Schlüssel im Schlüsselbund von rcyay-bau" bash -c "runuser -u rcyay-bau -- env HOME=$BAUHOME gpg --batch --list-keys $FPR >/dev/null 2>&1"
check "Schlüssel kam vom Schlüsselserver" grep -q "pks/lookup.*$FPR" "$W/server.log"
R -S --noconfirm rc-pgp; r=$?
check "Schlüssel vorhanden -> keine Nachfrage" bash -c "[ $r = 0 ] && ! grep -q 'need importing' '$W/out'"
schluessel_weg
yes y | R -S rc-pgp; r=$?
check "mit Rückfrage (ja) importiert und gebaut" bash -c "[ $r = 0 ] && grep -q 'Import?' '$W/out'"
runuser -u rcyay-bau -- env HOME="$BAUHOME" gpgconf --kill all 2>/dev/null

# ---------- gescheiterter Bau: keine Waisen ----------
aufraeumen
R -S --noconfirm rc-orphan; r=$?
check "rc-orphan: Bau scheitert" [ $r != 0 ]
check "Repo-Laufzeitabh. rc-repodep wieder entfernt" notinst rc-repodep
check "AUR-Laufzeitabh. rc-orphan-dep wieder entfernt" notinst rc-orphan-dep
check "Repo-Bauabh. rc-repomake wieder entfernt" notinst rc-repomake
R -S --noconfirm --noremovemake rc-orphan; r=$?
check "--noremovemake: Abh. bleiben und werden genannt" bash -c "[ $r != 0 ] && grep -q 'remain' '$W/out' && pacman -Q rc-repodep >/dev/null"
aufraeumen

# ---------- PATH der Bauumgebung (sudo secure_path / runuser) ----------
env PATH=/usr/local/sbin:/usr/local/bin:/usr/bin "$RCYAY" --config "$W/pacman.conf" --rcyayconf "$W/rcyay.conf" -S --noconfirm rc-perlpath >"$W/out" 2>&1; r=$?
check "knapper PATH: pod2man (core_perl) beim Bau gefunden" bash -c "[ $r = 0 ] && grep -q core_perl/pod2man /usr/share/rcyay-test/rc-perlpath"

# ---------- deutsches Locale (Dezimalkomma) ----------
if locale -a 2>/dev/null | grep -qi '^de_DE.utf-\?8$'; then
  LANG=de_DE.UTF-8 LC_ALL=de_DE.UTF-8 R -Ss rc-hello; r=$?
  check "de_DE: -Ss liest AUR-JSON (Popularity)" bash -c "[ $r = 0 ] && grep -q '^aur/rc-hello' '$W/out'"
  LANG=de_DE.UTF-8 LC_ALL=de_DE.UTF-8 R -Si rc-hello; r=$?
  check "de_DE: -Si" bash -c "[ $r = 0 ] && grep -q 'rc-hello' '$W/out' && ! grep -q JSON '$W/out'"
  LANG=de_DE.UTF-8 LC_ALL=de_DE.UTF-8 R -S --noconfirm rc-orphan-dep; r=$?
  check "de_DE: -S baut und installiert" bash -c "[ $r = 0 ] && pacman -Q rc-orphan-dep >/dev/null"
  if [ -f /usr/share/locale/de/LC_MESSAGES/rcyay.mo ]; then
    check "de_DE: Meldungen deutsch" grep -q "Abhängigkeiten" "$W/out"
  else N=$((N+1)); echo "ok $N - # SKIP de_DE Meldungen: rcyay.mo nicht installiert"; fi
else
  for t in "-Ss" "-Si" "-S" "Meldungen"; do N=$((N+1)); echo "ok $N - # SKIP de_DE $t: Locale fehlt (locale-gen)"; done
fi

# ---------- VirtualProvides (Metapaket usrside-provides) ----------
aufraeumen; vp_weg
vpconf() { { cat "${VPBASE:-$W/rcyay.conf}"; for l in "$@"; do echo "VirtualProvides = $l"; done; } > "$W/vp.conf"; chmod 644 "$W/vp.conf"; }
VP() { "$RCYAY" --config "$W/pacman.conf" --rcyayconf "$W/vp.conf" "$@" >"$W/out" 2>&1; }
vprov() { pacman -Qi usrside-provides 2>/dev/null | sed -n 's/^Provides *: //p' | tr -s ' ' '\n' | sort | tr '\n' ' '; }
vpconf
VP -S --noconfirm rc-needsvirt; r=$?
check "ohne VirtualProvides: rc-needsvirt nicht installierbar" bash -c "[ $r != 0 ] && ! pacman -Q rc-needsvirt >/dev/null 2>&1"
check "ohne VirtualProvides: kein usrside-provides" notinst usrside-provides
vpconf "rc-virt-a rc-virt-b=2.0" "rc-virt-a bad>=1 rc-virt-c"
VP --provides list
check "--provides list: 3 Einträge, doppelte zusammengefasst" [ "$(grep -c '^rc-virt' "$W/out")" = 3 ]
check "ungültiger Eintrag gemeldet" has "invalid entry 'bad>=1'"
check "--provides list: Metapaket nicht aktuell" has "not up to date"
VP -S --noconfirm rc-needsvirt; r=$?
check "Repo-Paket mit virtueller Abh. installiert" bash -c "[ $r = 0 ] && pacman -Q rc-needsvirt >/dev/null"
check "usrside-provides 1-1 erzeugt" ver usrside-provides 1-1
check "provides = Liste" [ "$(vprov)" = "rc-virt-a rc-virt-b=2.0 rc-virt-c " ]
check "usrside-provides ausdrücklich installiert" reason usrside-provides Explicitly
check "pacman -T: rc-virt-a und rc-virt-b>=1.5 erfüllt" pacman -T rc-virt-a 'rc-virt-b>=1.5'
check "pacman -T: rc-virt-b>2.0 nicht erfüllt" bash -c "! pacman -T 'rc-virt-b>2.0' >/dev/null"
check "keine Paketdatei liegen geblieben" bash -c "! ls '$W'/bau-root/.provides/*.pkg.tar >/dev/null 2>&1"
check "Paket ohne Dateien" [ -z "$(pacman -Qlq usrside-provides)" ]
VP --provides list
check "--provides list: jetzt aktuell" hasnot "not up to date"
VP -S --noconfirm rc-hello
check "Liste unverändert: kein neues Metapaket" bash -c "grep -q . '$W/out' && ! grep -q 'VirtualProvides changed' '$W/out' && [ \"\$(pacman -Q usrside-provides | cut -d' ' -f2)\" = 1-1 ]"
VP -S --noconfirm rc-aurvirt; r=$?
check "AUR: versionierte virtuelle Abh. (rc-virt-b>=1.5) erfüllt, gebaut" bash -c "[ $r = 0 ] && pacman -Q rc-aurvirt >/dev/null"
check "AUR: keine Repo-Abh. für virtuelle Namen" hasnot "Installing repo dependencies"
vpconf "rc-virt-a rc-virt-b=1.0 rc-virt-c"
VP -S --noconfirm rc-hello; r=$?
check "Version zu klein für installiertes rc-aurvirt -> pacman verweigert, Abbruch" bash -c "[ $r != 0 ] && grep -q 'failed to install usrside-provides' '$W/out'"
check "usrside-provides unverändert 1-1" ver usrside-provides 1-1
pacman -Rdd --noconfirm rc-aurvirt >/dev/null 2>&1
VP -S --noconfirm rc-aurvirt; r=$?
check "rc-virt-b=1.0: Metapaket 2-1, AUR-Plan meldet fehlende Abh." bash -c "[ $r != 0 ] && grep -q 'dependency not found: rc-virt-b>=1.5' '$W/out' && [ \"\$(pacman -Q usrside-provides | cut -d' ' -f2)\" = 2-1 ]"
# -U: lokales Paket mit virtueller Abh.; Liste ändert sich -> vor -U angepasst
mkdir -p "$W/uvirt"; cat > "$W/uvirt/PKGBUILD" <<'P'
pkgname=rc-uvirt
pkgver=1.0
pkgrel=1
arch=(any)
license=(MIT)
depends=(rc-virt-d)
package() { mkdir -p "$pkgdir/usr/share/rcyay-test"; echo rc-uvirt > "$pkgdir/usr/share/rcyay-test/rc-uvirt"; }
P
chown -R nobody: "$W/uvirt"
runuser -u nobody -- bash -c "cd '$W/uvirt' && makepkg -f -d >/dev/null 2>&1"
UP=$(ls "$W"/uvirt/rc-uvirt-*.pkg.tar.* 2>/dev/null | head -1)
VP -U --noconfirm "$UP"; r=$?
check "-U ohne rc-virt-d in der Liste scheitert" bash -c "[ $r != 0 ] && ! pacman -Q rc-uvirt >/dev/null 2>&1"
vpconf "rc-virt-a rc-virt-b=1.0 rc-virt-c rc-virt-d"
VP -U --noconfirm "$UP"; r=$?
check "-U: Metapaket vorher angepasst (3-1), rc-uvirt installiert" bash -c "[ $r = 0 ] && pacman -Q rc-uvirt >/dev/null && [ \"\$(pacman -Q usrside-provides | cut -d' ' -f2)\" = 3-1 ]"
# leere Liste: entfernen nur, wenn nichts mehr davon abhängt
vpconf
VP -S --noconfirm rc-hello; r=$?
check "leere Liste, Abh. noch gebraucht: bleibt, Warnung, Lauf ok" bash -c "[ $r = 0 ] && grep -q 'stays installed' '$W/out' && pacman -Q usrside-provides >/dev/null"
aufraeumen
VP --provides apply; r=$?
check "leere Liste, nichts hängt ab: --provides apply entfernt usrside-provides" bash -c "[ $r = 0 ] && ! pacman -Q usrside-provides >/dev/null 2>&1"
# Nutzer über sudo, Bauordner im Home
VPBASE="$W/rcyay-nutzer.conf" vpconf "rc-virt-a"
runuser -u "$NUTZER" -- env HOME="$(getent passwd "$NUTZER" | cut -d: -f6)" "$RCYAY" --config "$W/pacman.conf" --rcyayconf "$W/vp.conf" -S --noconfirm rc-needsvirt >"$W/out" 2>&1; r=$?
check "Nutzer: Metapaket über sudo, rc-needsvirt installiert" bash -c "[ $r = 0 ] && pacman -Q rc-needsvirt >/dev/null && [ '$(vprov)' = 'rc-virt-a ' ]"
aufraeumen; vp_weg

# ---------- als normaler Nutzer (sudo) ----------
aufraeumen
RU -S --noconfirm rc-chain-a; r=$?
check "Nutzer: -S Kette über sudo (Exit 0)" [ $r = 0 ]
check "Nutzer: rc-chain-a installiert" installed rc-chain-a
check "Nutzer: makepkg lief als $NUTZER" grep -q " $NUTZER\$" /usr/share/rcyay-test/rc-chain-a
check "Nutzer: Bauabh. entfernt" notinst rc-maketool
check "Nutzer: Bauordner im Home" test -d "$(getent passwd "$NUTZER" | cut -d: -f6)/.cache/rcyay/rc-chain-a"
RU -Ss rc-hello; check "Nutzer: -Ss" has "^aur/rc-hello"

# ---------- Server-Protokoll ----------
check "Snapshots nur einmal je Lauf geholt" bash -c "! grep -q 'snapshot/rc-split.tar.gz' '$W/server.log' || [ \$(grep -c 'snapshot/rc-split.tar.gz' '$W/server.log') -le 2 ]"

echo "1..$N"
[ $FAIL = 0 ] && { echo "# alle $N Tests grün"; rm -rf "$W"; exit 0; }
echo "# $FAIL von $N Tests fehlgeschlagen (Arbeitsordner $W bleibt)"; exit 1
