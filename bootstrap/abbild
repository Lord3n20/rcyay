#!/bin/bash
# abbild: bootfähiges qcow2 aus dem Repo von stage2 (btrfs, Subvolume @ und @home) mit usrkrnl ohne Initramfs.
#   bootstrap/abbild [--nur-kernel] [AUSGABEORDNER]       (Standard /root/aus)
# Ausgabe (Vertrag mit ~/vm/rcyay/test-rcyay):
#   usrside-VARIANTE.qcow2    GPT: 1 ESP (vfat, Kernel als EFI/BOOT/BOOTX64.EFI), 2 btrfs (@ = /, @home)
#   usrside-VARIANTE.vmlinuz  usrkrnl-bzImage (virtio, btrfs, 9p fest eingebaut; kein Initramfs)
#   usrside-VARIANTE.cmdline  root=/dev/vda2 rootfstype=btrfs rootflags=subvol=@ rw
#   usrside-VARIANTE.inits    INIT PFAD (alle Inits im selben Abbild, Wahl per init=)
#   usrside-VARIANTE.commit   git-Hash von bootstrap
# Umgebung: GROESSE (Standard 12G), SCHLUESSEL (authorized_keys für root, Standard /root/.ssh/authorized_keys),
#   USRKRNL (Standard /root/usrsideos/usrkrnl bzw. ~/usrsideos/usrkrnl), PAKETE (Standard: alle aus dem Repo),
#   KERNEL_NUTZER (normaler Nutzer für usrkrnl/setup, Standard bau)
set -euo pipefail
. "$(dirname "$0")/lib.sh"
((EUID == 0)) || abbruch "abbild braucht root (losetup, mount, chroot)"
brauche qemu-img sfdisk losetup mkfs.btrfs mkfs.vfat btrfs clang ld.lld
NUR_KERNEL=0
[[ ${1:-} == --nur-kernel ]] && { NUR_KERNEL=1; shift; }
AUS=${1:-/root/aus}
REPO=$ARBEIT/$VARIANTE/repo
REPONAME=usrside-$VARIANTE
GROESSE=${GROESSE:-12G}
SCHLUESSEL=${SCHLUESSEL:-/root/.ssh/authorized_keys}
CMDLINE="root=/dev/vda2 rootfstype=btrfs rootflags=subvol=@ rw"
((NUR_KERNEL)) || [[ -s $REPO/$REPONAME.db.tar.zst ]] || abbruch "kein Repo $REPO – zuerst bootstrap/stage2"
if [[ -z ${USRKRNL:-} ]]; then
	for d in /root/usrsideos/usrkrnl "$HOME/usrsideos/usrkrnl"; do [[ -x $d/setup ]] && { USRKRNL=$d; break; }; done
fi
[[ -x ${USRKRNL:-}/setup ]] || abbruch "usrkrnl nicht gefunden (USRKRNL=…/usrkrnl)"
KBAU=$ARBEIT/usrkrnl
KERNEL_NUTZER=${KERNEL_NUTZER:-bau}
mkdir -p "$AUS" "$KBAU"

# ---- Kernel: usrkrnl für die Test-VM (virtio + btrfs + 9p eingebaut, Module unkomprimiert für BusyBox) ----
kernel() {
	cat >"$KBAU/abbild.config" <<-'EOF'
		CONFIG_BTRFS_FS=y
		CONFIG_BTRFS_FS_POSIX_ACL=y
		CONFIG_VIRTIO=y
		CONFIG_VIRTIO_PCI=y
		CONFIG_VIRTIO_BLK=y
		CONFIG_VIRTIO_NET=y
		CONFIG_VIRTIO_CONSOLE=y
		CONFIG_HW_RANDOM_VIRTIO=y
		CONFIG_NET_9P=y
		CONFIG_NET_9P_VIRTIO=y
		CONFIG_9P_FS=y
		CONFIG_9P_FS_POSIX_ACL=y
		CONFIG_SERIAL_8250=y
		CONFIG_SERIAL_8250_CONSOLE=y
		CONFIG_DEVTMPFS=y
		CONFIG_DEVTMPFS_MOUNT=y
		CONFIG_UNIX=y
		CONFIG_PACKET=y
		CONFIG_VFAT_FS=y
		CONFIG_EFI_STUB=y
		CONFIG_MODULE_COMPRESS_NONE=y
		# CONFIG_MODULE_COMPRESS_ZSTD is not set
		# CONFIG_MODULE_COMPRESS_XZ is not set
		# CONFIG_MODULE_COMPRESS_GZIP is not set
	EOF
	local base=$KBAU/base.config
	if [[ -r /proc/config.gz ]]; then zcat /proc/config.gz >"$base"; else cp "/boot/config-$(uname -r)" "$base"; fi
	lsmod >"$KBAU/lsmod"
	# usrkrnl/setup läuft nur als normaler Nutzer
	chown -R "$KERNEL_NUTZER" "$KBAU"
	su -s /bin/bash "$KERNEL_NUTZER" -c "env USRKRNL_SRC='$KBAU/src' HOME='$KBAU' '$USRKRNL/setup' --config-only \
		--reminimize --base '$base' --modules '$KBAU/lsmod' --extra '$KBAU/abbild.config' \
		--cmdline 'console=ttyS0,115200'"
	local tree
	tree=$(find "$KBAU/src" -maxdepth 1 -name 'linux-*' -type d | sort -V | tail -n1)
	# eingebaute Befehlszeile für das Abbild (setup trägt die Wurzel des Bauwirts ein)
	"$tree/scripts/config" --file "$tree/.config" --set-str CMDLINE "$CMDLINE"
	local llvm
	llvm=$(dirname "$(command -v clang)")
	make -C "$tree" LLVM="$llvm/" LOCALVERSION= olddefconfig >/dev/null
	local s
	for s in BTRFS_FS VIRTIO_BLK VIRTIO_NET VIRTIO_PCI 9P_FS NET_9P_VIRTIO SERIAL_8250_CONSOLE DEVTMPFS_MOUNT; do
		grep -q "^CONFIG_$s=y" "$tree/.config" || abbruch "CONFIG_$s ist nicht =y"
	done
	make -C "$tree" LLVM="$llvm/" LOCALVERSION= -j"$JOBS" bzImage modules
	printf '%s\n' "$tree" >"$KBAU/baum"
}

# ---- Platte ----
platte_anlegen() {
	local roh=$KBAU/abbild.raw
	rm -f "$roh"
	truncate -s "$GROESSE" "$roh"
	sfdisk -q "$roh" <<-'EOF'
		label: gpt
		size=256MiB, type=uefi, name=esp
		type=linux, name=usrside
	EOF
}

SCHLEIFE=""
MNT=$KBAU/mnt
abhaengen() {
	aushaengen
	mountpoint -q "$MNT/efi" && umount "$MNT/efi"
	mountpoint -q "$MNT/home" && umount "$MNT/home"
	mountpoint -q "$MNT" && umount "$MNT"
	[[ -n $SCHLEIFE ]] && losetup -d "$SCHLEIFE" 2>/dev/null
	SCHLEIFE=""
}
trap abhaengen EXIT

installieren() {
	local roh=$KBAU/abbild.raw tree pakete
	tree=$(<"$KBAU/baum")
	SCHLEIFE=$(losetup -P -f --show "$roh")
	mkfs.vfat -F 32 -n ESP "${SCHLEIFE}p1" >/dev/null
	mkfs.btrfs -q -f -L usrside "${SCHLEIFE}p2"
	mkdir -p "$MNT"
	mount "${SCHLEIFE}p2" "$MNT"
	btrfs -q subvolume create "$MNT/@"
	btrfs -q subvolume create "$MNT/@home"
	umount "$MNT"
	mount -o subvol=@,compress=zstd "${SCHLEIFE}p2" "$MNT"
	mkdir -p "$MNT/home" "$MNT/efi"
	mount -o subvol=@home,compress=zstd "${SCHLEIFE}p2" "$MNT/home"
	mount "${SCHLEIFE}p1" "$MNT/efi"
	mkdir -p "$MNT/var/lib/pacman" "$MNT/srv/$REPONAME"

	# Repo ins Abbild (rcyay -Syu im Abbild nutzt file:///srv/usrside-VARIANTE)
	cp -a "$REPO/." "$MNT/srv/$REPONAME/"
	# Installation mit rcyay aus dem stage2-chroot (musl), Ziel als -r
	chroot_grund "$WURZEL"
	einhaengen "$WURZEL" "$MNT" /mnt/abbild --bind
	einhaengen "$WURZEL" "$REPO" /usrside/repo --bind
	local pm=rcyay
	chroot "$WURZEL" rcyay -V >/dev/null 2>&1 || pm=pacman
	pakete=${PAKETE:-$(chroot "$WURZEL" "$pm" -Sylq "$REPONAME" | sort -u | tr '\n' ' ')}
	meldung "installiere: $pakete"
	# shellcheck disable=SC2086
	chroot "$WURZEL" env LC_ALL=C "$pm" -r /mnt/abbild --cachedir /mnt/abbild/var/cache/pacman/pkg \
		-Sy --noconfirm --needed $pakete
	chroot "$WURZEL" env LC_ALL=C "$pm" -r /mnt/abbild -Dk
	aushaengen

	# Kernel-Module und Kernel
	make -C "$tree" LLVM="$(dirname "$(command -v clang)")/" LOCALVERSION= INSTALL_MOD_PATH="$MNT/usr" \
		INSTALL_MOD_STRIP=1 DEPMOD=/bin/true modules_install
	rm -f "$MNT"/usr/lib/modules/*/build
	depmod -b "$MNT/usr" "$(make -s -C "$tree" LOCALVERSION= kernelrelease)"
	install -Dm644 "$tree/arch/x86/boot/bzImage" "$MNT/efi/EFI/BOOT/BOOTX64.EFI"
	install -Dm644 "$tree/arch/x86/boot/bzImage" "$MNT/boot/vmlinuz-usrkrnl"

	# Konfiguration
	install -dm700 "$MNT/root/.ssh"
	install -m600 "$SCHLUESSEL" "$MNT/root/.ssh/authorized_keys"
	cat >"$MNT/etc/fstab" <<-EOF
		# <file system> <dir> <type> <options> <dump> <pass>
		LABEL=usrside /home btrfs subvol=@home,compress=zstd 0 0
		LABEL=ESP     /efi  vfat  noauto,umask=0077 0 2
	EOF
	printf 'usrside-%s\n' "$VARIANTE" >"$MNT/etc/hostname"
	sed -i 's|^#\?PermitRootLogin.*|PermitRootLogin prohibit-password|' "$MNT/etc/ssh/sshd_config"
	sync
}

ausgeben() {
	local n=usrside-$VARIANTE tree commit
	tree=$(<"$KBAU/baum")
	qemu-img convert -c -O qcow2 "$KBAU/abbild.raw" "$AUS/$n.qcow2.neu"
	mv "$AUS/$n.qcow2.neu" "$AUS/$n.qcow2"
	install -m644 "$tree/arch/x86/boot/bzImage" "$AUS/$n.vmlinuz"
	printf '%s\n' "$CMDLINE" >"$AUS/$n.cmdline"
	printf '%s\n' "busybox /usr/bin/init" "runit /usr/bin/runit-init" \
		"s6 /etc/s6-linux-init/current/bin/init" >"$AUS/$n.inits"
	commit=${ABBILD_COMMIT:-}
	[[ -n $commit ]] || commit=$(git -c safe.directory='*' -C "$BOOTSTRAP" rev-parse HEAD 2>/dev/null || true)
	[[ -n $commit ]] || commit=$(git -c safe.directory='*' -C /root/rcyay rev-parse bootstrap 2>/dev/null || echo unbekannt)
	printf '%s\n' "$commit" >"$AUS/$n.commit"
	rm -f "$KBAU/abbild.raw"
	ls -l "$AUS"/"$n".*
}

schritt abbild-kernel kernel
((NUR_KERNEL)) && exit 0
platte_anlegen
installieren
abhaengen
ausgeben
meldung "Abbild fertig: $AUS/usrside-$VARIANTE.qcow2"
