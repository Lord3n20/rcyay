# s6-linux-init (skarnet.org) für s6 als Init
pkgname=s6-linux-init
pkgver=1.2.0.2
pkgrel=1
pkgdesc='tools for a Linux init system based on s6'
arch=(x86_64)
url='https://skarnet.org/software/s6-linux-init/'
license=(ISC)
depends=(musl skalibs execline s6)
source=("https://skarnet.org/software/s6-linux-init/s6-linux-init-$pkgver.tar.gz")
sha256sums=('6fad014da162c0c81924197c57d16e1a75c133b34a20e423431a1b741e907b1d')

build() {
	cd "s6-linux-init-$pkgver"
	./configure --prefix=/usr --bindir=/usr/bin --sbindir=/usr/bin --libdir=/usr/lib \
		--libexecdir=/usr/lib/s6-linux-init --with-sysdeps=/usr/lib/skalibs/sysdeps \
		--enable-shared --disable-static --disable-allstatic 
	make
}

package() {
	cd "s6-linux-init-$pkgver"
	make DESTDIR="$pkgdir" install
	install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
