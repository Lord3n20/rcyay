# execline (skarnet.org) für s6 als Init
pkgname=execline
pkgver=2.10.0.0
pkgrel=1
pkgdesc='small scripting language from skarnet.org'
arch=(x86_64)
url='https://skarnet.org/software/execline/'
license=(ISC)
depends=(musl skalibs)
source=("https://skarnet.org/software/execline/execline-$pkgver.tar.gz")
sha256sums=('561be2ce578604644e2263a889bbdf4736e7980401ee88556a7f9017c166dbab')

build() {
	cd "execline-$pkgver"
	./configure --prefix=/usr --bindir=/usr/bin --sbindir=/usr/bin --libdir=/usr/lib \
		--libexecdir=/usr/lib/execline --with-sysdeps=/usr/lib/skalibs/sysdeps \
		--enable-shared --disable-static --disable-allstatic 
	make
}

package() {
	cd "execline-$pkgver"
	make DESTDIR="$pkgdir" install
	install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
