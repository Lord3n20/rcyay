# skalibs (skarnet.org) für s6 als Init
pkgname=skalibs
pkgver=2.16.0.0
pkgrel=1
pkgdesc='general-purpose libraries from skarnet.org'
arch=(x86_64)
url='https://skarnet.org/software/skalibs/'
license=(ISC)
depends=(musl)
source=("https://skarnet.org/software/skalibs/skalibs-$pkgver.tar.gz")
sha256sums=('90a3deda94a40d7d6a4495fe6feaf91c0185e0428d59cbd150a1a468741269aa')

build() {
	cd "skalibs-$pkgver"
	./configure --prefix=/usr --bindir=/usr/bin --sbindir=/usr/bin --libdir=/usr/lib \
		--libexecdir=/usr/lib/skalibs --with-sysdeps=/usr/lib/skalibs/sysdeps \
		--enable-shared --disable-static --disable-allstatic --with-sysdeps-cpu=x86_64
	make
}

package() {
	cd "skalibs-$pkgver"
	make DESTDIR="$pkgdir" install
	install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
