# s6 (skarnet.org) für s6 als Init
pkgname=s6
pkgver=2.15.1.1
pkgrel=1
pkgdesc='process supervision suite from skarnet.org'
arch=(x86_64)
url='https://skarnet.org/software/s6/'
license=(ISC)
depends=(musl skalibs execline)
source=("https://skarnet.org/software/s6/s6-$pkgver.tar.gz")
sha256sums=('62080839eb5b04d51efd4ef6e7b43e29b5d0576efce9eb319ace32ea90c05931')

build() {
	cd "s6-$pkgver"
	./configure --prefix=/usr --bindir=/usr/bin --sbindir=/usr/bin --libdir=/usr/lib \
		--libexecdir=/usr/lib/s6 --with-sysdeps=/usr/lib/skalibs/sysdeps \
		--enable-shared --disable-static --disable-allstatic 
	make
}

package() {
	cd "s6-$pkgver"
	make DESTDIR="$pkgdir" install
	install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
