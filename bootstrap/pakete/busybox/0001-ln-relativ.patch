 #define LN_SUFFIX           (1 << 4)
 #define LN_VERBOSE          (1 << 5)
 #define LN_LINKFILE         (1 << 6)
+#define LN_RELATIVE         (1 << 7)
+#define LN_TARGETDIR        (1 << 8)
+
+/* UsrsideOS: GNU "ln -r" (update-ca-trust: ln -fsr -t DIR FILE).
+ * Like coreutils, TARGET and the directory of LINK are canonicalized
+ * (symlinks resolved, the last component of TARGET may be missing). */
+static char *relative_target(const char *target, const char *link)
+{
+	char *t, *d, *dir, *res, *p;
+	size_t i, sep;
+	unsigned up;
+
+	p = xstrdup(target);
+	t = xmalloc_realpath_coreutils(p);
+	free(p);
+	dir = xstrdup(link);
+	p = strrchr(dir, '/');
+	if (!p)
+		strcpy(dir, ".");
+	else if (p == dir)
+		p[1] = '\0';
+	else
+		*p = '\0';
+	d = xmalloc_realpath(dir);
+	free(dir);
+	if (!t || !d) {
+		bb_perror_msg("%s", t ? link : target);
+		free(t);
+		free(d);
+		return NULL;
+	}
+	/* longest common prefix ending at a component boundary */
+	sep = 0;
+	for (i = 0; t[i] && t[i] == d[i]; i++)
+		if (t[i] == '/')
+			sep = i;
+	if ((d[i] == '\0' && (t[i] == '/' || t[i] == '\0'))
+	 || (t[i] == '\0' && d[i] == '/'))
+		sep = i;
+	up = 0;
+	for (p = d + sep; *p; p++)
+		if (*p == '/' && p[1] && p[1] != '/')
+			up++;
+	p = t + sep;
+	while (*p == '/')
+		p++;
+	res = xzalloc(up * 3 + strlen(p) + 2);
+	while (up--)
+		strcat(res, "../");
+	strcat(res, p);
+	i = strlen(res);
+	if (i == 0)
+		strcpy(res, ".");
+	else if (res[i - 1] == '/')
+		res[i - 1] = '\0';
+	free(t);
+	free(d);
+	return res;
+}
 
