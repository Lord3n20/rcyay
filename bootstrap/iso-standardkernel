#!/bin/bash
# iso-standardkernel EIN.iso AUS.iso [LINUX-PAKET] – Live-Medium mit dem vollen Arch-Standardkernel (Paket linux)
# statt usrkrnl (Befund Laptop 28.11.: usrkrnl-Live ohne linux-firmware → i915 GuC fehlt, „GPU wedged“, kein WLAN/BT).
# Änderungen gegenüber EIN.iso:
#   rootfs.sfs: + linux (Module, /usr/lib/modules/VER/vmlinuz) + linux-firmware samt Teilpaketen (Offline-Spiegel
#               des Mediums), Module-Kaltstart über modalias + mdev-Regel für Hotplug, getty auf tty1 (root autologin)
#   BOOTX64.EFI: UKI (systemd-stub) = Arch-Kernel + Initramfs (BusyBox musl + bootstrap/live-init + Speicher-/
#               Dateisystem-Module) + Befehlszeile (aus der alten BOOTX64.EFI)
# Alles andere (Offline-Spiegel, Repos, Quellen, Installer) bleibt; Volume-Id wie EIN.iso. Braucht root.
# LINUX-PAKET: Standard das neueste linux-*.pkg.tar.zst in /var/cache/pacman/pkg.
set -euo pipefail
IN=$(readlink -f "${1:?EIN.iso}"); OUT=$(readlink -f "${2:?AUS.iso}")
BOOTSTRAP=$(dirname "$(readlink -f "$0")")
[[ $(id -u) = 0 ]] || { echo "braucht root"; exit 1; }
for t in unsquashfs mksquashfs xorriso objcopy objdump depmod modprobe bsdtar cpio zstd mkfs.vfat mmd mcopy; do
	command -v "$t" >/dev/null || { echo "fehlt: $t"; exit 1; }
done
STUB=/usr/lib/systemd/boot/efi/linuxx64.efi.stub
[[ -s $STUB ]] || { echo "fehlt: $STUB (systemd)"; exit 1; }
LINUX=${3:-$(find /var/cache/pacman/pkg -maxdepth 1 -name 'linux-[0-9]*-x86_64.pkg.tar.zst' | sort -V | tail -n1)}
[[ -s $LINUX ]] || { echo "kein linux-Paket"; exit 1; }
W=$(mktemp -d "${TMPDIR:-/var/tmp}/iso-standardkernel.XXXXXX")
aufraeumen() { umount -q "$W/iso" 2>/dev/null || true; rm -rf "$W"; }
trap aufraeumen EXIT
mkdir -p "$W/iso" "$W/baum" "$W/cache"
mount -o loop,ro "$IN" "$W/iso"
VOLID=$(xorriso -indev "$IN" -pvd_info 2>/dev/null | sed -n 's/^Volume Id *: //p')
CMDLINE=$(strings "$W/iso/EFI/BOOT/BOOTX64.EFI" | grep -m1 -E '^console=.*init=' || true)
[[ -n $VOLID && -n $CMDLINE ]] || { echo "Volume-Id/Befehlszeile nicht gefunden"; exit 1; }
echo ":: $VOLID, Befehlszeile: $CMDLINE, Kernel: $(basename "$LINUX")"

echo ":: Rootfs entpacken"
RFS=$W/rfs
unsquashfs -q -d "$RFS" "$W/iso/usrside/rootfs.sfs"

echo ":: linux + linux-firmware ins Rootfs"
FW=$(find "$W/iso/usrside/arch/core" -maxdepth 1 -name 'linux-firmware*.pkg.tar.zst' | sort)
[[ -n $FW ]] || { echo "kein linux-firmware im Offline-Spiegel"; exit 1; }
for d in proc sys dev; do mount --bind "/$d" "$RFS/$d"; done
# shellcheck disable=SC2086
pacman --root "$RFS" --dbpath "$RFS/var/lib/pacman" --cachedir "$W/cache" --noconfirm --noscriptlet \
	--assume-installed initramfs -U "$LINUX" $FW
for d in dev sys proc; do umount "$RFS/$d"; done
KVER=$(bsdtar -tf "$LINUX" | sed -n 's|^usr/lib/modules/\([^/]*\)/vmlinuz$|\1|p')
[[ -n $KVER && -s $RFS/usr/lib/modules/$KVER/vmlinuz ]] || { echo "vmlinuz fehlt"; exit 1; }
depmod -b "$RFS" "$KVER"
[[ -s $RFS/usr/lib/firmware/i915/mtl_guc_70.bin.zst ]] || echo "   Warnung: i915/mtl_guc_70 fehlt"

echo ":: Live-Einstellungen (Module, getty tty1)"
# Kaltstart: Module für alle vorhandenen Geräte (mdev -s lädt keine), danach Hotplug über mdev.conf
mkdir -p "$RFS/etc/usrside/start.d"
cat >"$RFS/etc/usrside/start.d/05-module.sh" <<-'EOF'
	# Live-Medium (iso-standardkernel): Module zu allen Geräten laden (Arch-Kernel, fast alles =m)
	find /sys/devices -name modalias -type f -exec cat {} + 2>/dev/null | sort -u | xargs -r modprobe -qab 2>/dev/null
	mdev -s 2>/dev/null
EOF
grep -q MODALIAS "$RFS/etc/mdev.conf" || printf '%s\n' '$MODALIAS=.*  root:root 0660 @modprobe -qb "$MODALIAS"' >>"$RFS/etc/mdev.conf"
mkdir -p "$RFS/etc/sv/getty-tty1"
cat >"$RFS/etc/sv/getty-tty1/run" <<-'EOF'
	#!/bin/sh
	exec /usr/bin/agetty --autologin root --noclear tty1 linux
EOF
chmod 755 "$RFS/etc/sv/getty-tty1/run"
ln -sfn /etc/sv/getty-tty1 "$RFS/etc/runit/runsvdir/default/getty-tty1"

echo ":: Initramfs"
D=$W/initramfs
mkdir -p "$D"/{bin,lib,dev,proc,sys,run,neu} "$W/pakete"
for p in busybox musl; do
	f=$(find "$W/iso/usrside/repo/usrside-musl" -maxdepth 1 -name "$p-[0-9]*.pkg.tar.zst" | sort -V | tail -n1)
	[[ -n $f ]] || { echo "kein $p im musl-Repo"; exit 1; }
	bsdtar -xf "$f" -C "$W/pakete"
done
install -m755 "$W/pakete/usr/bin/busybox" "$D/bin/busybox"
install -m755 "$(readlink -f "$W/pakete/usr/lib/libc.so")" "$D/lib/ld-musl-x86_64.so.1"
install -m755 "$BOOTSTRAP/live-init" "$D/init"
mknod -m 600 "$D/dev/console" c 5 1
mknod -m 666 "$D/dev/null" c 1 3
# Module zum Finden des Mediums (USB/NVMe/SATA/SD/CD, Dateisysteme, loop/squashfs/overlay, Ventoy-dm) und Tastatur
# für die Notfall-Shell; samt Abhängigkeiten, entpackt (BusyBox-modprobe kann kein zstd)
MODULE="xhci_pci xhci_pci_renesas ehci_pci ohci_pci uhci_hcd usb_storage uas sd_mod sr_mod nvme ahci mmc_block
	sdhci_pci sdhci_acpi rtsx_pci_sdmmc virtio_blk virtio_pci virtio_scsi loop squashfs overlay isofs vfat exfat
	ntfs3 ext4 btrfs xfs nls_cp437 nls_iso8859_1 nls_utf8 dm_mod usbhid hid_generic atkbd i8042 thunderbolt"
MB=$D/lib/modules/$KVER
mkdir -p "$MB"
for m in $MODULE; do
	modprobe -d "$RFS" -S "$KVER" --show-depends "$m" 2>/dev/null | awk '$1 == "insmod" {print $2}'
done | sort -u | while read -r k; do
	z=${k#"$RFS"/usr/lib/modules/"$KVER"/}
	mkdir -p "$MB/$(dirname "$z")"
	case $z in *.zst) zstd -qd "$k" -o "$MB/${z%.zst}" ;; *.xz) xz -dc "$k" >"$MB/${z%.xz}" ;; *) cp "$k" "$MB/$z" ;; esac
done
cp "$RFS/usr/lib/modules/$KVER"/modules.{builtin,builtin.modinfo,order} "$MB/"
depmod -b "$D" "$KVER"
echo "   $(find "$MB" -name '*.ko' | wc -l) Module"
(cd "$D" && find . -print0 | LC_ALL=C sort -z | cpio --null -o -H newc --reproducible --quiet) | zstd -19 -q >"$W/initramfs.img"

echo ":: UKI"
printf '%s' "$CMDLINE" >"$W/cmdline"
printf 'NAME="UsrsideOS Live"\nID=usrside\nPRETTY_NAME="UsrsideOS Live (%s)"\n' "$KVER" >"$W/osrel"
align=$((16#$(objdump -p "$STUB" | awk '/SectionAlignment/ {print $2}')))
off=$(objdump -h "$STUB" | awk 'NF == 7 && $1 ~ /^[0-9]+$/ {e = strtonum("0x" $3) + strtonum("0x" $4); if (e > m) m = e} END {print m}')
args=()
for s in osrel cmdline initrd linux; do
	case $s in initrd) f=$W/initramfs.img ;; linux) f=$RFS/usr/lib/modules/$KVER/vmlinuz ;; *) f=$W/$s ;; esac
	off=$(((off + align - 1) / align * align))
	args+=(--add-section ".$s=$f" --change-section-vma ".$s=$(printf 0x%x "$off")")
	off=$((off + $(stat -c %s "$f")))
done
objcopy "${args[@]}" "$STUB" "$W/BOOTX64.EFI"
objdump -h "$W/BOOTX64.EFI" | grep -E '\.(osrel|cmdline|initrd|linux)' | awk '{print "   " $2, $3}'

echo ":: Rootfs packen"
cp -a "$W/iso/." "$W/baum/"
chmod -R u+w "$W/baum"
rm -f "$W/baum/usrside/rootfs.sfs"
mksquashfs "$RFS" "$W/baum/usrside/rootfs.sfs" -comp zstd -Xcompression-level 19 -b 1M -noappend -quiet
install -m644 "$W/BOOTX64.EFI" "$W/baum/EFI/BOOT/BOOTX64.EFI"
printf '%s, Standardkernel %s\n' "$(cat "$W/iso/usrside/version")" "$KVER" >"$W/baum/usrside/version"
umount "$W/iso"

echo ":: EFI-Abbild + xorriso"
kb=$(($(stat -c %s "$W/BOOTX64.EFI") / 1024 + 2048))
mkfs.vfat -C -n USRSIDE_EFI "$W/efi.img" "$kb" >/dev/null
mmd -i "$W/efi.img" ::/EFI ::/EFI/BOOT
mcopy -i "$W/efi.img" "$W/BOOTX64.EFI" ::/EFI/BOOT/BOOTX64.EFI
rm -f "$OUT"
xorriso -as mkisofs -iso-level 3 -full-iso9660-filenames -joliet -joliet-long -rational-rock \
	-volid "$VOLID" -appid "UsrsideOS Live/Installer" -publisher "UsrsideOS" \
	-partition_offset 16 \
	-append_partition 2 C12A7328-F81F-11D2-BA4B-00A0C93EC93B "$W/efi.img" -appended_part_as_gpt \
	-e --interval:appended_partition_2:all:: -no-emul-boot \
	-o "$OUT" "$W/baum" 2>&1 | grep -v '^xorriso : UPDATE' || true
[[ -s $OUT ]] || { echo "kein ISO"; exit 1; }
(cd "$(dirname "$OUT")" && sha256sum "$(basename "$OUT")" >"$(basename "$OUT").sha256")
ls -l "$OUT"; cat "$OUT.sha256"
