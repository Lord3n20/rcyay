#!/bin/bash
# Notbehelf (Befund t1, 26.11.): fakeroot wirkt auf musl nicht auf bsdtar/tar (stat-Aufrufe werden nicht
# abgefangen) → alle stage2-Pakete enthalten uid/gid 1000 (bau). Dieses Skript packt jedes Paket im Repo mit
# root:root neu (Inhalt, Rechte, setuid-Bits und Zeitstempel bleiben; .MTREE wird mit root:root neu erzeugt)
# und erneuert die Repo-Datenbank. Läuft als root auf dem Bauwirt (Arch-bsdtar), nicht im chroot.
#   bootstrap/besitzer-reparieren [REPO]      (Standard $ARBEIT/$VARIANTE/repo)
# Erledigt sich, sobald fakeroot auf musl richtig funktioniert (siehe README, „Offen“).
set -euo pipefail
. "$(dirname "$0")/lib.sh"
((EUID == 0)) || abbruch "besitzer-reparieren braucht root"
brauche bsdtar zstd repo-add
REPO=${1:-$ARBEIT/$VARIANTE/repo}
REPONAME=usrside-$VARIANTE
tmp=$(mktemp -d "$ARBEIT/besitzer.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
n=0
for p in "$REPO"/*.pkg.tar.zst; do
	# schon richtig? (erste Nutzdatei gehört root)
	bsdtar -tvf "$p" | awk '{print $3}' | grep -qvx root || continue
	d=$tmp/inhalt
	rm -rf "$d"
	mkdir -p "$d"
	bsdtar -xpf "$p" -C "$d" --numeric-owner
	(
		cd "$d"
		rm -f .MTREE
		# Dateiliste wie makepkg: Metadaten zuerst, dann alle Einträge (mit -n, daher vollständig)
		{
			printf '%s\0' .PKGINFO .BUILDINFO
			[[ -e .INSTALL ]] && printf '.INSTALL\0'
			[[ -e .CHANGELOG ]] && printf '.CHANGELOG\0'
			find . -mindepth 1 ! -name .PKGINFO ! -name .BUILDINFO ! -name .INSTALL ! -name .CHANGELOG -printf '%P\0' | LC_ALL=C sort -z
		} >"$tmp/liste"
		LANG=C bsdtar -cnf - --format=mtree --uid 0 --gid 0 --uname root --gname root \
			--options='!all,use-set,type,uid,gid,mode,time,size,md5,sha256,link' --null --files-from "$tmp/liste" |
			gzip -c -f -n >.MTREE
		{ printf '.MTREE\0'; cat "$tmp/liste"; } >"$tmp/liste2"
		LANG=C bsdtar -cnf - --uid 0 --gid 0 --uname root --gname root --null --files-from "$tmp/liste2" |
			zstd -q -19 -T0 >"$p.neu"
	)
	# Sicherung: gleiche Zahl an Einträgen wie vorher
	[[ $(bsdtar -tf "$p" | wc -l) == "$(bsdtar -tf "$p.neu" | wc -l)" ]] || abbruch "$p: Eintragszahl weicht ab"
	mv "$p.neu" "$p"
	rm -f "$p.sig"
	n=$((n + 1))
done
cd "$REPO"
rm -f "$REPONAME".{db,files}*
repo-add -q "$REPONAME.db.tar.zst" ./*.pkg.tar.zst
meldung "Besitzer repariert: $n Pakete in $REPO"
